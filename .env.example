# Copy to .env on a local machine. Never commit .env or real keys.
# Host secrets (Cloudflare Pages → Settings → Environment variables).

# Stripe test-mode keys only until George explicitly goes live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Printful — token stays on George's machine / host secrets. Store 18687336.
PRINTFUL_API_TOKEN=
PRINTFUL_STORE_ID=18687336
# Leave false so even a paid webhook creates a Printful draft, not a charged order.
PRINTFUL_CONFIRM_ORDERS=false

# Google AdSense — leave empty until Google issues a real publisher ID.
ADSENSE_PUBLISHER_ID=
ADSENSE_ENABLED=false

# Public flip switches. Both stay false until George says otherwise.
CHECKOUT_ENABLED=false

# Public site origin used for Stripe success/cancel URLs and CORS.
APP_ORIGIN=https://habibicraftsco.com
